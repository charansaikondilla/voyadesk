{
  "name": "voyadesk",
  "private": true,
  "version": "1.0.0",
  "description": "VoyaDesk \u2014 travel business CRM, portals and website (clean-room build)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace apps/web",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "verify": "npm run typecheck && npm test && npm run build",
    "smoke": "node apps/web/scripts/smoke.mjs http://localhost:4173/",
    "start": "npm run start --workspace apps/api",
    "preview": "npm run preview --workspace apps/web"
  },
  "engines": {
    "node": ">=20"
  }
}