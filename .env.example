# Copy to .env (or set in your host) for apps/api
NODE_ENV=production
PORT=8080
# DATABASE_URL=postgres://voyadesk:password@localhost:5432/voyadesk
JWT_SECRET=change-me-to-at-least-32-random-characters
WEBHOOK_SECRET=change-me
META_VERIFY_TOKEN=change-me
# CORS_ORIGIN=https://app.example.com
# WEB_DIST=../web/dist

# Encrypts each agency's integration keys (set a different 32+ char value from JWT_SECRET)
# SECRETS_KEY=change-me-to-another-32-random-characters
# Public https address of the API (shown as webhook URLs in Settings → Integrations)
# PUBLIC_API_URL=https://api.youragency.in
# Background jobs: on by default
# JOBS=on
